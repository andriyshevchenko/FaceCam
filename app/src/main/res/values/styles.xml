<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="card">#F1F1F4</color>
    <color name="accent">#E53935</color>
    <color name="icon">#555555</color>

    <style name="AppTheme" parent="android:Theme.DeviceDefault.DayNight">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorControlActivated">@color/accent</item>
    </style>

    <style name="Section">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">24dp</item>
        <item name="android:layout_marginBottom">4dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/accent</item>
        <item name="android:letterSpacing">0.08</item>
    </style>

    <style name="Label">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:alpha">0.7</item>
    </style>
</resources>
