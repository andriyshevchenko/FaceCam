    <!-- Consent -->
    <string name="consent_title">Before you start</string>
    <string name="consent_body">Hahacam records camera video and microphone audio after you tap “Start recording” — even when you switch to another app or lock the screen. While recording, a notification with a “Stop” button is shown in the notification shade.\n\nVideos are stored only on your phone and are never sent anywhere.\n\nBy agreeing, you confirm that you understand:\n• other people may accidentally appear in the frame — don\'t film them without consent;\n• recording continues in the background and with the screen locked until you stop it;\n• you are responsible for your recordings and how you use them.</string>
    <string name="consent_check">I have read and agree to the Terms of Use and Privacy Policy</string>
