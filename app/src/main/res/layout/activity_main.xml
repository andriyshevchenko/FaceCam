<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hahacam"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:alpha="0.7"
            android:text="@string/tagline"
            android:textSize="14sp" />

        <!-- Статус -->
        <LinearLayout
            android:id="@+id/statusCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/card"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/statusTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/status_ready"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/statusTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="monospace"
                android:text="00:00"
                android:textSize="44sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/statusSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:alpha="0.7"
                android:gravity="center"
                android:text=""
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnRec"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/btn_rec"
                android:text="@string/btn_start"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnShareLast"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/share_last"
                android:textAllCaps="false"
                android:textColor="@color/accent"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Режим -->
        <TextView
            style="@style/Section"
            android:text="@string/section_mode" />

        <RadioGroup
            android:id="@+id/rgMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/rbModeCamera"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="44dp"
                android:text="@string/mode_camera" />

            <RadioButton
                android:id="@+id/rbModeScreen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="44dp"
                android:text="@string/mode_screen" />
        </RadioGroup>

        <TextView
            android:id="@+id/modeHint"
            style="@style/Label"
            android:text="@string/mode_screen_hint" />

        <!-- Кружечок (лише режим екрана) -->
        <LinearLayout
            android:id="@+id/bubbleSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/Section"
                android:text="@string/section_bubble" />

            <TextView
                style="@style/Label"
                android:text="@string/bubble_corner" />

            <Spinner
                android:id="@+id/spCorner"
                android:layout_width="match_parent"
                android:layout_height="48dp" />

            <TextView
                style="@style/Label"
                android:text="@string/bubble_size" />

            <Spinner
                android:id="@+id/spBubble"
                android:layout_width="match_parent"
                android:layout_height="48dp" />

            <Switch
                android:id="@+id/swAppAudio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/app_audio_switch" />
        </LinearLayout>

        <!-- Налаштування -->
        <TextView
            style="@style/Section"
            android:text="@string/section_camera" />

        <RadioGroup
            android:id="@+id/rgCamera"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbFront"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/cam_front" />

            <RadioButton
                android:id="@+id/rbBack"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/cam_back" />
        </RadioGroup>

        <RadioGroup
            android:id="@+id/rgQuality"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rb1080"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="1080p" />

            <RadioButton
                android:id="@+id/rb720"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/q_720" />
        </RadioGroup>

        <Switch
            android:id="@+id/swAudio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/audio_switch" />

        <TextView
            style="@style/Section"
            android:text="@string/section_timer" />

        <LinearLayout
            android:id="@+id/delayRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/Label"
                android:text="@string/delay_label" />

            <Spinner
                android:id="@+id/spDelay"
                android:layout_width="match_parent"
                android:layout_height="48dp" />
        </LinearLayout>

        <TextView
            style="@style/Label"
            android:text="@string/autostop_label" />

        <Spinner
            android:id="@+id/spAutoStop"
            android:layout_width="match_parent"
            android:layout_height="48dp" />

        <!-- Автообрізання -->
        <TextView
            style="@style/Section"
            android:text="@string/section_trim" />

        <Switch
            android:id="@+id/swTrim"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/trim_switch" />

        <TextView
            style="@style/Label"
            android:text="@string/trim_hint" />

        <LinearLayout
            android:id="@+id/tailRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/Label"
                android:text="@string/tail_label" />

            <Spinner
                android:id="@+id/spTail"
                android:layout_width="match_parent"
                android:layout_height="48dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/hiddenSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

        <TextView
            style="@style/Section"
            android:text="@string/section_notif" />

        <Switch
            android:id="@+id/swHidden"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/hidden_switch" />

        <TextView
            android:id="@+id/hiddenHint"
            style="@style/Label"
            android:text="@string/hidden_hint" />

        <Button
            android:id="@+id/btnChannel"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/hidden_disable"
            android:textAllCaps="false" />
        </LinearLayout>

        <!-- Записи -->
        <TextView
            style="@style/Section"
            android:text="@string/section_recordings" />

        <TextView
            android:id="@+id/emptyList"
            style="@style/Label"
            android:text="@string/empty_list" />

        <LinearLayout
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <!-- Юридичне -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:gravity="center"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnTerms"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alpha="0.75"
                    android:text="@string/terms"
                    android:textAllCaps="false"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnPrivacy"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alpha="0.75"
                    android:text="@string/privacy"
                    android:textAllCaps="false"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:alpha="0.5"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
